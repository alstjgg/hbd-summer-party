---
import Base from '../layouts/Base.astro';
import FiveMarks from '../components/FiveMarks.astro';

/**
 * Every fact on this page is confirmed in PRODUCT.md. Nothing here may be
 * extended without a confirmed source — in particular no person is named
 * anywhere in rendered output, the host included.
 */
const VENUE = '어반피크닉 워터파티룸 · 분당서현';
const VENUE_FULL = '어반피크닉 워터파티룸 분당서현점';
const MAP_URL = 'https://naver.me/Fr7bgqO0';
const base = import.meta.env.BASE_URL;

const KIT = [
  {
    src: base + 'img/kit-swimsuit.png',
    name: '수영복',
    note: '젖어도 되는 옷이면 뭐든 괜찮아요',
    alt: '수영복 캐릭터가 한 손을 흔들고 있는 그림',
  },
  {
    src: base + 'img/kit-towel.png',
    name: '수건',
    note: '한 장이면 충분해요',
    alt: '돌돌 말린 수건 캐릭터가 두 팔을 벌리고 있는 그림',
  },
  {
    src: base + 'img/kit-clothes.png',
    name: '갈아입을 옷',
    note: '돌아갈 때 입을 마른 옷',
    alt: '개어놓은 옷 캐릭터가 두 팔을 벌리고 있는 그림',
  },
];
---

<Base
  title="HBD SUMMER PARTY · 2026.08.28"
  description="여름에 태어난 다섯 사람이 함께 여는 생일 파티. 8월 28일 금요일 오후 5시, 어반피크닉 워터파티룸 분당서현점. 수영복과 수건, 갈아입을 옷을 챙겨오세요."
>
  <main>
    <!-- ── The poster ────────────────────────────────────────────────── -->
    <header class="bill">
      <h1 class="bill__title poster">HBD SUMMER PARTY</h1>

      <figure class="bill__art">
        <img
          src={`${base}img/cake-hero.png`}
          width="969"
          height="972"
          alt="다섯 개의 초를 꽂은 생일 케이크 캐릭터가 커다란 튜브를 끼고 손을 흔들고 있는 그림"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <p class="bill__when poster">8.28 <span class="bill__time">17:00</span></p>
      <p class="bill__where">{VENUE}</p>
    </header>

    <!-- ── Five equals ───────────────────────────────────────────────── -->
    <section class="band band--left" aria-labelledby="five-heading">
      <h2 id="five-heading" class="ko-display ko-display--xl">다섯이 모두 주인공</h2>
      <div class="band__body">
        <p>여름에 태어난 다섯 사람이 서로를 축하합니다.</p>
        <p>
          아무의 생일도 아닌 날에 모여서, 다섯 번 축하하고 다섯 번 축하받아요. 주인공도 손님도
          따로 없습니다.
        </p>
      </div>
      <FiveMarks label="똑같은 초 다섯 개" class="band__marks" />
    </section>

    <!-- ── When and where ────────────────────────────────────────────── -->
    <section class="band band--rule" aria-labelledby="when-heading">
      <h2 id="when-heading" class="ko-display">8월 28일 금요일, 오후 다섯 시</h2>

      <dl class="facts">
        <div class="facts__row">
          <dt>날짜</dt>
          <dd>2026년 8월 28일 <span class="facts__dim">금요일</span></dd>
        </div>
        <div class="facts__row">
          <dt>시간</dt>
          <dd>오후 5시</dd>
        </div>
        <div class="facts__row">
          <dt>장소</dt>
          <dd>{VENUE_FULL}</dd>
        </div>
      </dl>

      <a class="action" href={MAP_URL} target="_blank" rel="noopener noreferrer">
        지도 열기
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M5 12h13M13 6l6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <p class="band__note">실내 워터파티룸이에요. 저녁에 모였다가 그날 헤어집니다.</p>
    </section>

    <!-- ── Bring these three ─────────────────────────────────────────── -->
    <section class="band band--fill" aria-labelledby="kit-heading">
      <h2 id="kit-heading" class="ko-display ko-display--xl">세 가지만 챙기면 돼요</h2>

      <ul class="kit">
        {
          KIT.map((item) => (
            <li class="kit__item">
              <img src={item.src} alt={item.alt} decoding="async" />
              <p class="kit__name">{item.name}</p>
              <p class="kit__note">{item.note}</p>
            </li>
          ))
        }
      </ul>

      <p class="band__note band__note--loud">풀이 작아요. 짐은 가볍게!</p>
    </section>

    <!-- ── One more thing ────────────────────────────────────────────── -->
    <section class="band band--rule" aria-labelledby="plus-heading">
      <h2 id="plus-heading" class="ko-display">혹시 같이 올 사람이 있다면</h2>
      <p class="band__body lede">미리 알려주세요. 자리를 맞춰둘게요.</p>
    </section>

    <!-- ── Close ─────────────────────────────────────────────────────── -->
    <footer class="close">
      <p class="close__line poster">See you<br />at the water</p>
      <p class="close__ko">8월 28일, 물가에서 만나요</p>
      <FiveMarks label="똑같은 초 다섯 개" class="close__marks" />
    </footer>
  </main>
</Base>

<style>
  /* ── The poster ──────────────────────────────────────────────────────
     Reproduces the approved comp's first viewport: header tracked across
     the top, character in the middle, date at display scale, venue small
     at the foot. Proportions follow the comp, not a default hero.        */
  .bill {
    min-height: 100svh;
    display: grid;
    grid-template-rows: repeat(4, auto);
    align-content: center;
    justify-items: center;
    gap: clamp(0.9rem, 3.2vw, 1.6rem);
    padding: clamp(0.9rem, 3.5vw, 2rem) var(--gutter) clamp(1.25rem, 4vw, 2.5rem);
    text-align: center;
  }

  .bill__title {
    font-size: min(clamp(1.6rem, 11.6vw, 13rem), 13svh);
    white-space: nowrap;
    letter-spacing: 0.005em;
    margin: 0;
  }

  .bill__art {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    margin: 0;
  }

  .bill__art img {
    width: min(96vw, 46rem);
    height: auto;
    max-height: min(54svh, 46rem);
    object-fit: contain;
    animation: float-bob 5.2s ease-in-out infinite;
  }

  /* An inflatable ring does not sit still on water. One bob, orchestrated,
     rather than scattered hover effects. */
  @keyframes float-bob {
    0%,
    100% {
      transform: translateY(0) rotate(-0.35deg);
    }
    50% {
      transform: translateY(-1.4%) rotate(0.35deg);
    }
  }

  .bill__when {
    font-size: min(clamp(2.6rem, 18.6vw, 20rem), 15svh);
    white-space: nowrap;
    letter-spacing: 0.005em;
  }

  .bill__time {
    margin-left: 0.04em;
  }

  .bill__where {
    font-family: var(--poster-ko);
    font-size: var(--fs-venue);
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--chartreuse);
  }

  /* ── Bands ───────────────────────────────────────────────────────── */
  .band {
    padding: clamp(3.5rem, 13vw, 6.5rem) var(--gutter);
    text-align: center;
  }

  /* Hairline rules only — the world has no cards and no elevation. */
  .band--rule {
    border-top: 2px solid color-mix(in srgb, var(--cream) 26%, transparent);
  }

  /* Off-centre: the poster world does not centre everything. */
  .band--left {
    text-align: left;
  }

  .band--left .band__body {
    max-width: var(--measure);
  }

  /* :global — the flex container lives on FiveMarks' own root, which Astro
     scopes to that component, so an unqualified descendant selector misses it. */
  .band--left :global(.five) {
    justify-content: flex-start;
  }

  /* A full-bleed colour band — the container grammar the brief names and the
     first build shipped nowhere. Pool text on chartreuse: 6.20:1. */
  .band--fill {
    background: var(--chartreuse);
    color: var(--pool);
  }

  .band--fill .ko-display,
  .band--fill .kit__name {
    color: var(--pool);
  }

  .band--fill .kit__note,
  .band--fill .band__note {
    /* 78% measured 4.35:1 against the chartreuse band — under the body floor. */
    color: color-mix(in srgb, var(--pool) 90%, var(--chartreuse));
  }

  .band--fill .band__note--loud {
    color: var(--pool);
  }

  .band__body {
    margin-top: 1.4rem;
  }

  .band__body p + p {
    margin-top: 0.85rem;
  }

  .band__marks {
    margin-top: clamp(2.25rem, 8vw, 3.5rem);
  }

  .band__note {
    margin-top: 1.75rem;
    font-size: var(--fs-note);
    color: color-mix(in srgb, var(--cream) 78%, var(--pool));
  }

  .band__note--loud {
    font-family: var(--poster-ko);
    font-size: var(--fs-ko-md);
    color: var(--chartreuse);
    letter-spacing: -0.01em;
  }

  /* ── Facts ───────────────────────────────────────────────────────── */
  .facts {
    margin: clamp(2rem, 7vw, 3rem) auto 0;
    max-width: 34rem;
    text-align: left;
  }

  .facts__row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-bottom: 2px solid color-mix(in srgb, var(--cream) 18%, transparent);
  }

  .facts__row:first-child {
    border-top: 2px solid color-mix(in srgb, var(--cream) 18%, transparent);
  }

  .facts dt {
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    color: color-mix(in srgb, var(--cream) 82%, var(--pool)); /* 8.78:1 base */
    text-transform: uppercase;
  }

  .facts dd {
    margin: 0;
    font-weight: 700;
    font-size: var(--fs-fact);
    line-height: 1.5;
  }

  .facts__dim {
    color: color-mix(in srgb, var(--cream) 72%, var(--pool));
  }

  /* ── The one action on the page ──────────────────────────────────────
     Chartreuse fill with pool-coloured text: 6.20:1, the only pairing in
     this palette that clears body contrast. Cream on persimmon measures
     2.25:1 and is banned outright (see the surface brief).               */
  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: clamp(2rem, 7vw, 2.75rem);
    padding: 1.1rem 2.1rem;
    border: var(--stroke) solid var(--outline);
    border-radius: 999px;
    background: var(--chartreuse);
    color: var(--pool);
    font-family: var(--poster-ko);
    font-size: clamp(1rem, 4.2vw, 1.2rem);
    letter-spacing: -0.01em;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background-color 180ms ease;
  }

  .action svg {
    width: 1.05em;
    height: 1.05em;
    flex: none;
    transition: transform 180ms ease;
  }

  .action:hover {
    background: var(--cream);
    transform: translateY(-2px);
  }

  .action:hover svg {
    transform: translateX(3px);
  }

  .action:active {
    transform: translateY(0);
  }

  /* ── The kit ─────────────────────────────────────────────────────── */
  .kit {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.25rem, 8vw, 3rem);
    margin: clamp(2.25rem, 8vw, 3.5rem) auto 0;
    max-width: 52rem;
  }

  .kit__item img {
    width: auto;
    height: min(11rem, 42vw);
    margin: 0 auto 1.1rem;
  }

  .kit__name {
    font-family: var(--poster-ko);
    font-size: var(--fs-ko-md);
    color: var(--chartreuse);
    letter-spacing: -0.01em;
  }

  .kit__note {
    margin-top: 0.3rem;
    font-size: var(--fs-note);
    color: color-mix(in srgb, var(--cream) 78%, var(--pool));
  }

  /* ── Close ───────────────────────────────────────────────────────── */
  .close {
    padding: clamp(4rem, 15vw, 8rem) var(--gutter) clamp(3rem, 11vw, 5rem);
    text-align: center;
    background: var(--pool-deep);
    border-top: 2px solid color-mix(in srgb, var(--cream) 26%, transparent);
  }

  .close__line {
    font-size: var(--fs-close);
    line-height: 1.02;
  }

  .close__ko {
    margin-top: 1.5rem;
    font-family: var(--poster-ko);
    font-size: var(--fs-ko-sm);
    color: var(--cream);
    letter-spacing: -0.01em;
  }

  .close__marks {
    margin-top: clamp(2.5rem, 9vw, 3.5rem);
  }

  /* ── Wider screens ───────────────────────────────────────────────── */
  @media (min-width: 40rem) {
    .kit {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
  }

  @media (min-width: 64rem) and (orientation: landscape) {
    .band--left {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      column-gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
      max-width: 82rem;
      margin-inline: auto;
    }

    .band--left .band__body {
      margin-top: 0.5rem;
    }

    .band--left .band__marks {
      grid-column: 2;
      margin-top: clamp(2rem, 4vw, 3rem);
    }

    .bill {
      gap: 1.5rem;
    }

    .bill__art img {
      width: min(46vw, 46rem);
      max-height: min(46svh, 46rem);
    }

    .band {
      padding-inline: max(var(--gutter), 8vw);
    }
  }

  /* Short landscape phones: the poster must not force the date off-screen. */
  @media (max-height: 34rem) and (orientation: landscape) {
    .bill {
      min-height: auto;
      padding-block: 2.5rem;
    }

    .bill__art img {
      max-height: 46svh;
    }
  }
</style>
